# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000

# --- Live "orders today" (optional) ---
# Create a custom app in your Shopify admin (Settings → Apps → Develop apps),
# give it read_orders scope, and paste the Admin API access token below.
# SHOPIFY_STORE=your-shop.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2024-10
